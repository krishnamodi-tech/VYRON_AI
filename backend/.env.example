# ==============================================================================
# VYRON AI 2.0 — Environment Configuration
# ==============================================================================

# Server Network Host & Port
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 1. Open-Weight Generative AI Inference (Preferred for Best Open-Source AI Track)
# ------------------------------------------------------------------------------
# Get your free fast API key at: https://console.groq.com/keys
GROQ_API_KEY=
# Verified open-weight model: llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen-qwq-32b
GROQ_MODEL=llama-3.3-70b-versatile
# Optional custom OpenAI-compatible endpoint (e.g. Local Ollama, vLLM, OpenRouter)
OPENAI_API_BASE=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 2. Google Gemini Fallback (Optional)
# ------------------------------------------------------------------------------
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Security, CORS & Upload Constraints
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=15
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*
